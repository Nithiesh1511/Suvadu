# Supabase connection.
# Copy this file to ".env.local" and fill in your project's values from
# Supabase → Settings → API. The anon (publishable) key is safe to expose in
# the client bundle — access is enforced server-side by Row-Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZnaGFlcmJ5cnZibHJoa3hza2dkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYxMTA4NDQsImV4cCI6MjEwMTY4Njg0NH0.UI_27PG9fJDOSIfc1ZYNk6QROdJKtDuIThc_El3gZBU

# ── Seed script only (scripts/seed-supabase.mjs) ─────────────────────────────
# The service_role key BYPASSES Row-Level Security — keep it secret, never ship
# it to the client. Only needed locally when running `npm run seed:supabase`.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID. If set, GA4 loads and tracks page views,
# add_to_cart and purchase events. Leave unset to disable analytics entirely.
# VITE_GA4_ID=G-XXXXXXXXXX
